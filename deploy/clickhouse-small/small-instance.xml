<?xml version="1.0"?>
<!--
  ClickHouse for a database that holds about a megabyte.

  Measured on the mint deployment 2026-08-17:

    db.default (every real table)   ~1 MB
    MemoryResident                  1.18 GiB
    cgroup memory billed            1.33 GB
    nagg-mint, the API beside it    0.035 GB

  ClickHouse was ~97% of the cost of the deployment, and none of it was data.

  It is also NOT the caches, which is the obvious guess and the wrong one. The
  mark cache is allowed 5 GiB but MarkCacheFiles was 3; those limits are
  ceilings, not reservations, and shrinking them saves nothing on its own.

  The memory is THREADS:

    GlobalThread        857
    GlobalThreadActive  750
    jemalloc.allocated  462 MiB   (the real heap; caches are empty)
    MemoryCode          475 MiB   (the binary, file-backed)

  857 threads for a database with three tables in it, because every pool is
  sized from the HOST — Railway's box reports 24 cores, so
  background_schedule_pool_size alone defaults to 512. The pool settings below
  are the entire point of this file; everything else is small change.

  Two guard rails learned the hard way:

    * max_thread_pool_free_size must stay <= max_thread_pool_size. Lowering only
      the latter (256, against a default free size of 1000) crash-looped the
      container on 2026-08-17.
    * Do NOT raise the logger level here. Setting it to `warning` is what made
      that crash loop silent — the startup error never reached `railway logs`.
      Cheap logs are not worth a blind restart loop.

  Memory ceiling: deliberately absent. max_server_memory_usage_to_ram_ratio
  (0.9) already resolves against the CGROUP, not the host — it read 21.6 GB
  against Railway's default 24 GB container. Setting the Railway resource limit
  therefore moves ClickHouse's internal ceiling with it, which is one knob
  instead of two that can disagree.

  Result, with the matching Railway limit (1 GB / 1 vCPU):

    GlobalThread             857    -> 256
    jemalloc.allocated       462 MiB -> 336 MiB
    billed memory            1.33 GB -> 0.73 GB
    max_server_memory_usage  21.6 GB -> 787 MB   (follows the cgroup)

  The remainder is floor: MemoryCode alone is 475 MiB of ClickHouse binary.

  A separate profile from deploy/clickhouse, not a copy of it. That one is tuned
  for a ~26 GB database whose merges flood the page cache, and its memory has
  twice been damaged by caps that were correct for a small instance. The two
  want opposite things and stay apart on purpose.
-->
<clickhouse>
    <!--
      Log to stdout so failures reach `railway logs`.
      This is load-bearing, not a nicety: without it ClickHouse writes only to
      /var/log/clickhouse-server/*.log inside the container, and a container
      that crash-loops on a config error takes the explanation with it. Two
      blind restart loops were debugged the hard way before this line existed.
    -->
    <logger>
        <console>1</console>
    </logger>

    <!--
      Thread pools. These are the 857 threads. Defaults in brackets, all
      host-derived; the values here are what a handful of small reads and
      kilobyte-sized merges actually need.
    -->
    <max_thread_pool_size>256</max_thread_pool_size>            <!-- [10000] -->
    <max_thread_pool_free_size>64</max_thread_pool_free_size>   <!-- [1000] must be <= max_thread_pool_size -->
    <background_schedule_pool_size>16</background_schedule_pool_size>  <!-- [512] the big one -->
    <background_fetches_pool_size>2</background_fetches_pool_size>      <!-- [16] no replicas here -->
    <background_move_pool_size>2</background_move_pool_size>            <!-- [8] no tiered storage here -->
    <background_message_broker_schedule_pool_size>2</background_message_broker_schedule_pool_size> <!-- [16] no Kafka/Rabbit -->
    <max_concurrent_queries>16</max_concurrent_queries>                 <!-- [1000]; nagg's own gate is 4 -->

    <!--
      background_pool_size and background_common_pool_size are deliberately left
      at their defaults (16 and 8).
      background_pool_size is not a free-standing number: ClickHouse refuses to
      start unless
          background_pool_size * background_merges_mutations_concurrency_ratio
      clears several <merge_tree> thresholds, the largest being
      number_of_free_entries_in_pool_to_execute_optimize_entire_partition (25).
      Setting it to 4 gave 4*2 = 8 and the server aborted at startup with
      Code 36 from MergeTreeSettingsImpl::sanityCheck.
      It could be lowered by also lowering those thresholds, but it is not where
      the threads are — background_schedule_pool_size above is 32x larger — so
      the coupling is not worth taking on.
    -->

    <!--
      Cache ceilings. Not where the memory went, but there is no reason to leave
      a 5 GiB allowance on a 1 MB database: it bounds the worst case if a query
      ever does pull a lot in.
    -->
    <mark_cache_size>67108864</mark_cache_size>                                       <!-- 64 MiB  [5 GiB] -->
    <index_mark_cache_size>16777216</index_mark_cache_size>                           <!-- 16 MiB  [5 GiB] -->
    <primary_index_cache_size>16777216</primary_index_cache_size>                     <!-- 16 MiB  [5 GiB] -->
    <vector_similarity_index_cache_size>16777216</vector_similarity_index_cache_size> <!-- 16 MiB  [5 GiB] -->
    <query_condition_cache_size>16777216</query_condition_cache_size>                 <!-- 16 MiB  [100 MiB] -->
    <uncompressed_cache_size>16777216</uncompressed_cache_size>                       <!-- 16 MiB  [8 GiB] -->
    <compiled_expression_cache_size>8388608</compiled_expression_cache_size>          <!-- 8 MiB   [128 MiB] -->

    <!--
      Self-observation. The samplers run every second by default, which on this
      instance wrote 298k asynchronous_metric_log rows in half an hour — more
      rows per hour than the database contains. Pure CPU and write savings.
    -->
    <asynchronous_metrics_update_period_s>60</asynchronous_metrics_update_period_s>
    <asynchronous_heavy_metrics_update_period_s>600</asynchronous_heavy_metrics_update_period_s>

    <!--
      System logs. deploy/clickhouse keeps a week of query_log/part_log because
      that instance has a history of wedged mutations worth forensics. Here the
      whole database is smaller than one hour of metric_log, and `railway logs`
      carries anything worth reading. Keep the two that answer "why was that
      slow" and "what happened to that part", short; drop the rest.

      Declared here rather than via ALTER TABLE for the reason migration 023
      records: MODIFY TTL changes the table structure, so the next restart
      renames it aside and orphans the data.
    -->
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <blob_storage_log remove="1"/>
    <filesystem_cache_log remove="1"/>
    <s3queue_log remove="1"/>
    <session_log remove="1"/>
    <zookeeper_log remove="1"/>

    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </part_log>
</clickhouse>
